	}

	EnableConsistentDifficulty: {
		// DisplayName: "Включить согласованную сложность"
		// Description: "Если включено, поведение врагов из более высоких уровней сложности будет присутствовать и на низких. Рекомендуется оставлять включённым, если нет проблем с совместимостью."
